#!/usr/bin/env bash
# noc-inv - create a handover-ready monitor/incident summary from the FINAL Datadog Notebook
# Usage: noc-inv [NAME] [NOTEBOOK_URL]
#        noc-inv --date YYYY-MM-DD [NAME] [NOTEBOOK_URL]
#        noc-inv --open NAME
#        noc-inv --non-interactive --shift-date YYYY-MM-DD --name SAFE_NAME \
#          --notebook-url FINAL_NOTEBOOK_URL --output-dir EXISTING_DIRECTORY
set -euo pipefail

NOC_ROOT="$HOME/noc"
DAY="$(date +%F)"
OPEN_AFTER=false
NAME=""
NOTEBOOK_URL=""

usage(){ cat <<'TXT'
Usage:
  noc-inv
  noc-inv NAME NOTEBOOK_URL
  noc-inv --date YYYY-MM-DD NAME NOTEBOOK_URL
  noc-inv --open NAME
  noc-inv --contract-version
  noc-inv --non-interactive --shift-date YYYY-MM-DD --name SAFE_NAME \
    [--display-title DISPLAY_TITLE] --notebook-url FINAL_NOTEBOOK_URL \
    --output-dir EXISTING_DIRECTORY

Non-interactive web contract (version 1):
  - All arguments are required except --display-title, which defaults to --name.
  - --output-dir must be an existing, canonical directory without symlink
    components. The command writes only OUTPUT_DIRECTORY/investigation.md.
  - Existing output files are never overwritten. The caller manages the staging
    directory and publishes the resulting record after validating it.
  - Datadog Notebook retrieval uses the authenticated GitHub Copilot CLI and
    configured Datadog MCP server. Datadog remains read-only.
  - This mode never prompts or falls back to manual entry. Generated output is
    marked for operator review; this command never updates shift notes.

Non-interactive exit codes:
  0  generated record passed noc-inv validation
  2  invalid arguments, shift date, or safe investigation name
  3  invalid Datadog Notebook URL
  4  unsafe or unavailable output directory
  5  GitHub Copilot CLI unavailable
  6  Datadog MCP retrieval failed
  7  generation timed out
  8  generated record is malformed (safe output is retained if available)
  9  filesystem failure or output conflict

Workflow:
  1. Investigate in Bits AI and document in the Datadog Notebook.
  2. Run the separate M365 validation flow and review its SharePoint HTML report.
  3. Re-check contradictions in Bits AI and update the Datadog Notebook yourself.
  4. After the Notebook is final, run noc-inv with that Notebook URL.
  5. noc-inv asks GitHub Copilot + Datadog MCP to create a handover-ready summary from Datadog evidence.
  6. In interactive mode, if MCP retrieval fails, enter the final Notebook findings manually.

noc-inv does NOT perform or store the separate M365 validation report.
TXT
}

validate_noninteractive_record() {
  local file="$1"
  local required_line section content

  [[ -s "$file" ]] || return 1
  for required_line in \
      "# Investigation: $DISPLAY_TITLE" \
      "- Display Title: $DISPLAY_TITLE" \
      "- Investigation Name: $NAME" \
      "- Shift Date: $DAY" \
      "- FINAL Datadog Notebook: $NOTEBOOK_URL" \
      "- Evidence Provenance: noc-inv" \
      "- Status: Generated - Requires Operator Review" \
      "- Source of truth: Final Datadog Notebook" \
      "- Datadog Notebook: $NOTEBOOK_URL" \
      "- Capture method: Datadog MCP"; do
    grep -Fqx -- "$required_line" "$file" || return 1
  done

  for section in \
      "Summary" \
      "Service / Environment" \
      "Customer / Service Impact" \
      "Timeline" \
      "Confirmed Findings" \
      "Current Status" \
      "Actions Taken" \
      "Escalation / Ownership" \
      "Next Actions" \
      "Handover Summary"; do
    grep -Fqx -- "## $section" "$file" || return 1
  done

  for section in \
      "Summary" \
      "Confirmed Findings" \
      "Current Status" \
      "Next Actions" \
      "Handover Summary"; do
    content=$(
      awk -v heading="## $section" '
        $0 == heading {capture=1; next}
        capture && /^## / {exit}
        capture && NF {print; exit}
      ' "$file"
    )
    case "${content,,}" in
      ""|tbd|todo|n/a|na|none|pending|"to be determined"|"no data available"|placeholder)
        return 1
        ;;
    esac
  done
}

if [[ "${1:-}" == "--contract-version" ]]; then
  [[ $# -eq 1 ]] || { echo "ERROR: Invalid arguments." >&2; exit 2; }
  printf 'noc-inv-contract=1\n'
  exit 0
fi

if [[ "${1:-}" == "--non-interactive" ]]; then
  shift
  DAY=""
  NAME=""
  DISPLAY_TITLE=""
  NOTEBOOK_URL=""
  OUTPUT_DIR=""
  TIMEOUT_SECONDS="${NOC_INV_TIMEOUT_SECONDS:-300}"
  declare -A SEEN_OPTIONS=()

  while [[ $# -gt 0 ]]; do
    option="$1"
    [[ $# -ge 2 ]] || { echo "ERROR: Invalid arguments." >&2; exit 2; }
    value="$2"
    case "$option" in
      --shift-date) key="shift-date"; DAY="$value" ;;
      --name) key="name"; NAME="$value" ;;
      --display-title) key="display-title"; DISPLAY_TITLE="$value" ;;
      --notebook-url) key="notebook-url"; NOTEBOOK_URL="$value" ;;
      --output-dir) key="output-dir"; OUTPUT_DIR="$value" ;;
      *) echo "ERROR: Invalid arguments." >&2; exit 2 ;;
    esac
    [[ -z "${SEEN_OPTIONS[$key]:-}" ]] || {
      echo "ERROR: Invalid arguments." >&2
      exit 2
    }
    SEEN_OPTIONS[$key]=1
    shift 2
  done

  for required in shift-date name notebook-url output-dir; do
    [[ -n "${SEEN_OPTIONS[$required]:-}" ]] || {
      echo "ERROR: Invalid arguments." >&2
      exit 2
    }
  done
  [[ "$TIMEOUT_SECONDS" =~ ^[1-9][0-9]{0,2}$ ]] \
    && (( TIMEOUT_SECONDS <= 900 )) || {
      echo "ERROR: Invalid arguments." >&2
      exit 2
    }
  [[ -n "$DISPLAY_TITLE" ]] || DISPLAY_TITLE="$NAME"

  if ! command -v python3 >/dev/null 2>&1; then
    echo "ERROR: Non-interactive validation is unavailable." >&2
    exit 9
  fi

  if VALIDATED_OUTPUT_DIR=$(python3 - "$DAY" "$NAME" "$DISPLAY_TITLE" "$NOTEBOOK_URL" "$OUTPUT_DIR" <<'PY'
import re
import sys
import unicodedata
from datetime import date
from pathlib import Path
from urllib.parse import unquote, urlsplit

day, name, display_title, notebook_url, output_dir = sys.argv[1:]

def fail(code):
    raise SystemExit(code)

if not re.fullmatch(r"[0-9]{4}-[0-9]{2}-[0-9]{2}", day):
    fail(2)
try:
    date.fromisoformat(day)
except ValueError:
    fail(2)

if (
    not name
    or len(name) > 80
    or name != name.casefold()
    or not name[0].isalnum()
    or not name[-1].isalnum()
    or any(not (char.isalnum() or char == "-") for char in name)
    or "--" in name
):
    fail(2)

if (
    not display_title.strip()
    or len(display_title) > 200
    or any(unicodedata.category(char) in {"Cc", "Cf", "Cs"} for char in display_title)
):
    fail(2)

if any(unicodedata.category(char) == "Cc" for char in notebook_url):
    fail(3)
try:
    parsed = urlsplit(notebook_url)
except ValueError:
    fail(3)

slug_pattern = re.compile(
    r"(?:[A-Za-z0-9._~!$&'()*+,;=:@-]|%[0-9A-Fa-f]{2})+"
)
invalid_escape = re.compile(r"%(?![0-9A-Fa-f]{2})")
valid_path = False
if not invalid_escape.search(parsed.path):
    decoded_path = unquote(parsed.path, errors="replace")
    segments = decoded_path.split("/")
    valid_path = (
        len(segments) in {3, 4}
        and segments[:2] == ["", "notebook"]
        and segments[2].isascii()
        and segments[2].isdecimal()
    )
    if len(segments) == 4:
        raw_slug = parsed.path.rsplit("/", 1)[-1]
        valid_path = (
            valid_path
            and bool(segments[3])
            and segments[3] not in {".", ".."}
            and bool(slug_pattern.fullmatch(raw_slug))
        )
    if any(unicodedata.category(char) == "Cc" for char in decoded_path):
        valid_path = False

    traversal_path = decoded_path
    for _ in range(5):
        nested_segments = traversal_path.split("/")
        if (
            len(nested_segments) not in {3, 4}
            or nested_segments[:2] != ["", "notebook"]
            or not nested_segments[2].isascii()
            or not nested_segments[2].isdecimal()
            or any(segment in {".", ".."} for segment in nested_segments)
        ):
            valid_path = False
            break
        decoded_again = unquote(traversal_path)
        if decoded_again == traversal_path:
            break
        traversal_path = decoded_again

if (
    parsed.scheme != "https"
    or parsed.hostname != "app.datadoghq.com"
    or parsed.netloc != "app.datadoghq.com"
    or parsed.username is not None
    or parsed.password is not None
    or parsed.query
    or parsed.fragment
    or not valid_path
):
    fail(3)

raw_parts = output_dir.split("/")
if (
    not output_dir.startswith("/")
    or any(part in {".", ".."} for part in raw_parts)
):
    fail(4)
directory = Path(output_dir)
try:
    if not directory.is_dir() or directory.is_symlink():
        fail(4)
    current = Path(directory.anchor)
    for part in directory.parts[1:]:
        current = current / part
        if current.is_symlink():
            fail(4)
    resolved = directory.resolve(strict=True)
except OSError:
    fail(4)
if str(resolved) != output_dir.rstrip("/") or not resolved.is_dir():
    fail(4)
output_file = resolved / "investigation.md"
if output_file.exists() or output_file.is_symlink():
    fail(9)
print(str(resolved))
PY
  ); then
    :
  else
    validation_status=$?
    case "$validation_status" in
      2) echo "ERROR: Invalid arguments." >&2 ;;
      3) echo "ERROR: Invalid Datadog Notebook URL." >&2 ;;
      4) echo "ERROR: Unsafe output directory." >&2 ;;
      *) echo "ERROR: Filesystem failure." >&2; validation_status=9 ;;
    esac
    exit "$validation_status"
  fi

  if ! command -v copilot >/dev/null 2>&1; then
    echo "ERROR: GitHub Copilot CLI unavailable." >&2
    exit 5
  fi
  if ! command -v timeout >/dev/null 2>&1; then
    echo "ERROR: Bounded generation is unavailable." >&2
    exit 9
  fi

  OUTPUT_DIR="$VALIDATED_OUTPUT_DIR"
  cd -- "$OUTPUT_DIR"
  [[ "$(pwd -P)" == "$OUTPUT_DIR" ]] || {
    echo "ERROR: Unsafe output directory." >&2
    exit 4
  }
  WORK_DIR=""
  cleanup_non_interactive() {
    if [[ -n "$WORK_DIR" && "$WORK_DIR" == "$OUTPUT_DIR"/.noc-inv.* ]]; then
      rm -rf -- "$WORK_DIR"
    fi
  }
  trap cleanup_non_interactive EXIT
  if ! WORK_DIR=$(mktemp -d "$OUTPUT_DIR/.noc-inv.XXXXXXXX"); then
    echo "ERROR: Filesystem failure." >&2
    exit 9
  fi

  PROMPT=$(cat <<EOF2
This is a READ-ONLY Datadog NOC investigation. Retrieve the exact FINAL Datadog Notebook through the configured Datadog MCP server using this authenticated GitHub Copilot CLI session. Never modify Datadog or any external system. Do not claim facts unless retrieved from the Notebook or directly supporting Datadog evidence. If MCP retrieval fails, do not invent findings or ask the operator for manual input.

Write a concise Markdown investigation with exactly these headings:
# Investigation: $DISPLAY_TITLE
- Display Title: $DISPLAY_TITLE
- Investigation Name: $NAME
- Shift Date: $DAY
- FINAL Datadog Notebook: $NOTEBOOK_URL
- Evidence Provenance: noc-inv
- Status: Generated - Requires Operator Review
- Source of truth: Final Datadog Notebook
- Datadog Notebook: $NOTEBOOK_URL
- Capture method: Datadog MCP
## Summary
## Service / Environment
## Customer / Service Impact
## Timeline
## Confirmed Findings
## Current Status
## Actions Taken
## Escalation / Ownership
## Next Actions
## Handover Summary

Investigation title and selected shift:
$DISPLAY_TITLE
$DAY

Exact FINAL Datadog Notebook URL:
$NOTEBOOK_URL

Return Markdown only. Keep all findings advisory and concise. If the Notebook cannot be retrieved, return exactly this single line instead of a fabricated investigation:
DATADOG_MCP_RETRIEVAL_FAILED
EOF2
)

  if timeout --kill-after=5 "$TIMEOUT_SECONDS" copilot -p "$PROMPT" \
      >"$WORK_DIR/generated.md" 2>/dev/null; then
    :
  else
    copilot_status=$?
    if [[ "$copilot_status" -eq 124 || "$copilot_status" -eq 137 ]]; then
      echo "ERROR: Investigation generation timed out." >&2
      exit 7
    fi
    echo "ERROR: Datadog MCP retrieval failed." >&2
    exit 6
  fi

  if [[ ! -s "$WORK_DIR/generated.md" ]]; then
    echo "ERROR: Datadog MCP retrieval failed." >&2
    exit 6
  fi
  if grep -Fqx -- "DATADOG_MCP_RETRIEVAL_FAILED" "$WORK_DIR/generated.md"; then
    echo "ERROR: Datadog MCP retrieval failed." >&2
    exit 6
  fi

  web_metadata_valid=true
  for metadata in \
    "- Display Title: $DISPLAY_TITLE" \
    "- Investigation Name: $NAME" \
    "- Shift Date: $DAY" \
    "- FINAL Datadog Notebook: $NOTEBOOK_URL" \
    "- Evidence Provenance: noc-inv"; do
    if ! grep -Fqx -- "$metadata" "$WORK_DIR/generated.md"; then
      web_metadata_valid=false
    fi
  done

  record_valid=false
  if $web_metadata_valid && validate_noninteractive_record "$WORK_DIR/generated.md"; then
    record_valid=true
  fi
  if $record_valid && ! awk '
      $0 == "## Next Actions" { capture=1; next }
      capture && /^## / { exit }
      capture && NF { found=1; exit }
      END { exit !found }
    ' "$WORK_DIR/generated.md"; then
    record_valid=false
  fi

  if ! ln -- "$WORK_DIR/generated.md" "$OUTPUT_DIR/investigation.md"; then
    echo "ERROR: Filesystem failure." >&2
    exit 9
  fi
  if ! chmod 600 "$OUTPUT_DIR/investigation.md"; then
    rm -f -- "$OUTPUT_DIR/investigation.md"
    echo "ERROR: Filesystem failure." >&2
    exit 9
  fi
  if ! $record_valid; then
    echo "GENERATED RECORD NEEDS REVIEW"
    exit 8
  fi
  echo "READY FOR REVIEW"
  exit 0
fi

while [[ $# -gt 0 ]]; do
  case "$1" in
    --date) [[ $# -ge 2 ]] || { echo "ERROR: --date requires YYYY-MM-DD" >&2; exit 1; }; DAY="$2"; shift 2 ;;
    --open) OPEN_AFTER=true; shift; [[ $# -gt 0 ]] && NAME="$1" && shift ;;
    -h|--help) usage; exit 0 ;;
    *) if [[ -z "$NAME" ]]; then NAME="$1"; elif [[ -z "$NOTEBOOK_URL" ]]; then NOTEBOOK_URL="$1"; else echo "ERROR: Unexpected argument: $1" >&2; exit 1; fi; shift ;;
  esac
done

date -d "$DAY" >/dev/null 2>&1 || { echo "ERROR: Invalid date: $DAY" >&2; exit 1; }
[[ -n "$NAME" ]] || read -rp "Investigation name: " NAME
SAFE=$(printf '%s' "$NAME" | tr ' /' '--' | tr -cd '[:alnum:]_.-')
[[ -n "$SAFE" ]] || { echo "ERROR: Invalid investigation name" >&2; exit 1; }

SHIFT_DIR="$NOC_ROOT/$DAY"
NOTES="$SHIFT_DIR/shift-notes.md"
DIR="$SHIFT_DIR/investigations/$SAFE"
EVIDENCE_DIR="$DIR/evidence"
MAIN="$DIR/investigation.md"
NOTEBOOK_FILE="$DIR/notebook-url.txt"
RAW="$EVIDENCE_DIR/copilot-notebook-summary.md"
LOG="$DIR/noc-inv.log"
mkdir -p "$EVIDENCE_DIR"
log(){ printf '[%s] %s\n' "$(date '+%Y-%m-%d %H:%M:%S')" "$*" >> "$LOG"; }

validate_generated_record() {
  local file="$1"
  local issues=0
  local section content

  echo
  echo "[3] Generated Record Validation"

  if [[ ! -s "$file" ]]; then
    echo "  [WARN] investigation.md is missing or empty"
    echo
    echo "Result: GENERATED RECORD NEEDS REVIEW"
    return 1
  fi

  # Required metadata produced by noc-inv/Copilot.
  for pattern in \
    "- Status:" \
    "- Source of truth:" \
    "- Datadog Notebook:" \
    "- Capture method:"
  do
    if grep -Fq -- "$pattern" "$file"; then
      printf '  [OK]   %s\n' "${pattern#- }"
    else
      printf '  [WARN] Missing metadata: %s\n' "${pattern#- }"
      issues=$((issues + 1))
    fi
  done

  # Every expected heading must exist.
  local expected_sections=(
    "Summary"
    "Service / Environment"
    "Customer / Service Impact"
    "Timeline"
    "Confirmed Findings"
    "Current Status"
    "Actions Taken"
    "Escalation / Ownership"
    "Next Actions"
    "Handover Summary"
  )

  for section in "${expected_sections[@]}"; do
    if grep -Fq -- "## $section" "$file"; then
      printf '  [OK]   %s heading\n' "$section"
    else
      printf '  [WARN] Missing heading: %s\n' "$section"
      issues=$((issues + 1))
    fi
  done

  # These are the minimum sections that must contain usable generated text.
  local required_content=(
    "Summary"
    "Confirmed Findings"
    "Current Status"
    "Handover Summary"
  )

  for section in "${required_content[@]}"; do
    content=$(
      awk -v heading="## $section" '
        $0 == heading {capture=1; next}
        capture && /^## / {exit}
        capture && NF {print; exit}
      ' "$file"
    )

    if [[ -n "$content" ]]; then
      printf '  [OK]   %s content\n' "$section"
    else
      printf '  [WARN] Empty generated section: %s\n' "$section"
      issues=$((issues + 1))
    fi
  done

  # Confirm the generated record references the final Notebook passed to noc-inv.
  if grep -Fq -- "$NOTEBOOK_URL" "$file"; then
    printf '  [OK]   Final Datadog Notebook URL\n'
  else
    printf '  [WARN] Final Datadog Notebook URL missing from generated record\n'
    issues=$((issues + 1))
  fi

  echo

  if [[ $issues -eq 0 ]]; then
    echo "Result: READY FOR HANDOVER"
    return 0
  fi

  echo "Result: GENERATED RECORD NEEDS REVIEW"
  echo "Issues: $issues"
  return 1
}

if $OPEN_AFTER && [[ -f "$MAIN" && -z "$NOTEBOOK_URL" ]]; then ${EDITOR:-nano} "$MAIN"; exit 0; fi
[[ -n "$NOTEBOOK_URL" ]] || read -rp "FINAL Datadog Notebook URL: " NOTEBOOK_URL
case "$NOTEBOOK_URL" in
  https://app.datadoghq.com/notebook/*|https://app.datadoghq.eu/notebook/*|https://*.datadoghq.com/notebook/*|https://*.datadoghq.eu/notebook/*) ;;
  *) echo "ERROR: That does not look like a Datadog Notebook URL." >&2; exit 1 ;;
esac
printf '%s\n' "$NOTEBOOK_URL" > "$NOTEBOOK_FILE"

if [[ -s "$MAIN" ]]; then
  echo "Investigation already exists: $MAIN"
  echo "Nothing was overwritten."
  echo "Open it with: noc-inv --open $SAFE"
  exit 0
fi

log "START: $NAME"
log "Final Datadog Notebook URL recorded"

write_manual(){
cat > "$MAIN" <<EOF2
# Investigation: $NAME

- Status: Reviewed Notebook Summary
- Source of truth: Final Datadog Notebook
- Datadog Notebook: $NOTEBOOK_URL
- Capture method: Manual fallback

## Summary

## Service / Environment

## Customer / Service Impact

## Timeline

## Confirmed Findings

## Current Status

## Actions Taken

## Escalation / Ownership

## Next Actions

## Handover Summary

EOF2
  echo
  echo "Manual fallback opened. Enter ONLY the findings from your final updated Datadog Notebook."
  "${EDITOR:-nano}" "$MAIN"
  log "Manual Notebook summary entered"
}

AUTOMATED=false
if command -v copilot >/dev/null 2>&1; then
  PROMPT=$(cat <<EOF2
This is a READ-ONLY NOC documentation task based on a FINAL Datadog Notebook.
Datadog Notebook URL: $NOTEBOOK_URL
Use configured Datadog MCP tools to retrieve the notebook or directly supporting Datadog evidence.
Do not modify Datadog or any external system.
The separate M365 Copilot validation has already happened outside this script. Do NOT perform another validation pass and do NOT create a validation report.
Do not claim notebook contents unless retrieved by a tool. Missing MCP results are not proof of absence.
Return Markdown ONLY with exactly these headings:
# Investigation: $NAME
- Status: Reviewed Notebook Summary
- Source of truth: Final Datadog Notebook
- Datadog Notebook: $NOTEBOOK_URL
- Capture method: Datadog MCP
## Summary
## Service / Environment
## Customer / Service Impact
## Timeline
## Confirmed Findings
## Current Status
## Actions Taken
## Escalation / Ownership
## Next Actions
## Handover Summary
Use only facts supported by the final Notebook or retrieved Datadog evidence. Do not invent or infer root cause, impact, ticket status, ownership, or closure.
EOF2
)
  echo; echo "[1] Reading final Datadog Notebook through Copilot / Datadog MCP"
  TMP="$RAW.tmp"
  if copilot -p "$PROMPT" > "$TMP" 2>>"$LOG" && [[ -s "$TMP" ]]; then
    mv "$TMP" "$RAW"
    cp "$RAW" "$MAIN"
    AUTOMATED=true
    log "Datadog MCP Notebook summary captured"
  else
    rm -f "$TMP"
    log "WARNING: Datadog MCP Notebook retrieval failed"
  fi
else
  log "WARNING: copilot CLI not found"
fi

if ! $AUTOMATED; then
  echo
  echo "[WARN] The final Notebook could not be captured through Datadog MCP."
  echo "  1) Enter the final Notebook findings manually now"
  echo "  2) Exit"
  read -rp "Selection [1-2]: " choice
  case "$choice" in 1) write_manual ;; 2) log "EXIT: manual fallback declined"; exit 1 ;; *) echo "Invalid selection." >&2; exit 1 ;; esac
fi

GENERATED_RECORD_OK=false

if validate_generated_record "$MAIN"; then
  GENERATED_RECORD_OK=true
  log "Generated investigation record validation: READY FOR HANDOVER"
else
  log "WARNING: Generated investigation record validation failed"
fi

# Never copy raw MCP output or the external validation report into shift notes.
# Only point the handover workflow to the reviewed Notebook-based local summary.
if $GENERATED_RECORD_OK &&
   [[ -f "$NOTES" ]] &&
   ! grep -Fq "Reviewed investigation: $NAME" "$NOTES"; then
  printf '\n- %s Reviewed investigation: %s - Summary: %s - Datadog Notebook: %s\n' "$(date '+%H:%M')" "$NAME" "$MAIN" "$NOTEBOOK_URL" >> "$NOTES"
  log "Reviewed investigation reference added to shift notes"
fi

if ! $GENERATED_RECORD_OK; then
  echo
  echo "[WARN] The final Notebook was accepted, but the generated investigation record failed output validation."
  echo "Review: $MAIN"
  echo "The investigation was NOT added to shift notes."
  log "Shift-note reference withheld because generated record validation failed"
fi

log "SUCCESS"
echo; echo "[2] Saved"
echo "Reviewed investigation: $MAIN"
echo "Datadog Notebook:       $NOTEBOOK_URL"
echo "Log:                    $LOG"
echo
echo "This record is based on the final Notebook. The separate M365 validation report is not stored by noc-inv."
if $OPEN_AFTER; then ${EDITOR:-nano} "$MAIN"; fi
