#!/usr/bin/env bash
# noc-console - interactive front end for the NOC automation toolkit

set -uo pipefail

NO_COLOR=false

# SES-style terminal palette
SES_ORANGE=$'\033[38;5;208m'
SES_CYAN=$'\033[38;5;45m'
GREEN=$'\033[38;5;82m'
YELLOW=$'\033[38;5;220m'
RED=$'\033[38;5;196m'
WHITE=$'\033[97m'
GRAY=$'\033[38;5;245m'
BOLD=$'\033[1m'
DIM=$'\033[2m'
RESET=$'\033[0m'

disable_colors() {
  SES_ORANGE=""
  SES_CYAN=""
  GREEN=""
  YELLOW=""
  RED=""
  WHITE=""
  GRAY=""
  BOLD=""
  DIM=""
  RESET=""
}

DAY=""

usage() {
  cat <<'TXT'
Usage:
  noc-console
  noc-console --yesterday
  noc-console --date YYYY-MM-DD

Options:
  --yesterday        Use the previous calendar day's shift.
  --date YYYY-MM-DD  Use a specific shift date.
  --no-color         Disable terminal colors.
  -h, --help         Show this help.
TXT
}

while [[ $# -gt 0 ]]; do
  case "$1" in
    --yesterday)
      DAY=$(date -d yesterday +%F)
      ;;

    --date)
      [[ $# -ge 2 ]] || {
        echo "ERROR: --date requires YYYY-MM-DD" >&2
        exit 1
      }

      DAY="$2"
      shift
      ;;

    -h|--help)
      usage
      exit 0
      ;;

    --no-color)
      NO_COLOR=true
      disable_colors
      ;;

    *)
      echo "ERROR: Unknown option: $1" >&2
      usage >&2
      exit 1
      ;;
  esac

  shift
done

if [[ -z "$DAY" ]]; then
  DAY=$(date +%F)
fi

date -d "$DAY" >/dev/null 2>&1 || {
  echo "ERROR: Invalid date: $DAY" >&2
  exit 1
}

pause() {
  echo
  read -rp "Press Enter to return to the NOC Console..." _
}

run_tool() {
  local tool="$1"
  local rc

  shift

  if ! command -v "$tool" >/dev/null 2>&1; then
    echo
    echo "[ERROR] $tool not found."
    return 127
  fi

  echo

  "$tool" "$@"
  rc=$?

  echo

  if [[ $rc -eq 0 ]]; then
    echo "[OK] $tool completed."
  else
    echo "[ERROR] $tool failed with exit code $rc."
  fi

  return 0
}

show_header() {
  printf '%s%s' "$SES_ORANGE" "$BOLD"
