build_ai_context() {
  local bundle="$1"
  local notes="$HOME/noc/$DAY/shift-notes.md"
  local ticket_dir="$HOME/noc/tickets/open"
  local investigation_root="$HOME/noc/$DAY/investigations"
  local f

  {
    echo "# NOC AI Context - $DAY"
    echo
    echo "Generated from local read-only NOC records."
    echo

    echo "## SHIFT NOTES"
    echo

    if [[ -s "$notes" ]]; then
      cat "$notes"
    else
      echo "No shift notes available."
    fi

    echo
    echo "## OPEN JIRA TICKETS"
    echo

    shopt -s nullglob
    local tickets=("$ticket_dir"/*.json)
    shopt -u nullglob

    if [[ ${#tickets[@]} -eq 0 ]]; then
      echo "No locally tracked open Jira tickets."
    else
      for f in "${tickets[@]}"; do
        jq -r '
          "- Ticket: " + (.id // "Unknown") +
          "\n  Summary: " + (.jira.summary // "[not provided]") +
          "\n  Status: " + (.jira.status // "[not provided]") +
          "\n  Environment: " + (.noc.environment // "[not provided]") +
          "\n  Next Action: " + (.noc.next_action // "[not provided]") +
          "\n  NOC Notes: " + (.noc.notes // "[none]") +
          "\n"
        ' "$f"
      done
    fi

    echo
    echo "## REVIEWED INVESTIGATIONS"
    echo

    shopt -s nullglob
    local investigations=(
      "$investigation_root"/*/investigation.md
    )
    shopt -u nullglob

    if [[ ${#investigations[@]} -eq 0 ]]; then
      echo "No reviewed investigations available."
    else
      for f in "${investigations[@]}"; do
        echo "### $(basename "$(dirname "$f")")"
        echo

        awk '
          /^## Confirmed Findings$/ {show=1}
          /^## Current Status$/ {show=1}
          /^## Next Actions$/ {show=1}
          /^## Handover Summary$/ {show=1}

          /^## / &&
          $0 !~ /^## (Confirmed Findings|Current Status|Next Actions|Handover Summary)$/ {
            show=0
          }

          show {print}
        ' "$f"

        echo
      done
    fi
  } > "$bundle"
}

run_ai_report() {
  local report_name="$1"
  local task="$2"
  local report_dir="$HOME/noc/$DAY/reports"
  local report="$report_dir/$report_name"
  local context

  if ! command -v copilot >/dev/null 2>&1; then
    echo
    printf '%s[ERROR] Copilot CLI not found.%s\n' "$RED" "$RESET"
    return 1
  fi

  mkdir -p "$report_dir"

  context=$(mktemp)
  build_ai_context "$context"

  local prompt
  prompt=$(cat <<EOF
This is a READ-ONLY NOC analysis task.

Shift date: $DAY

Use ONLY the operational context supplied below.
Do not modify files or external systems.
Do not invent ticket states, owners, impact, root cause, deadlines,
incident closure, or completed actions.

TASK:
$task

OPERATIONAL CONTEXT:
$(cat "$context")

Return concise Markdown.
EOF
)

  echo
  printf '%sRunning Copilot analysis...%s\n' "$SES_CYAN" "$RESET"

  if copilot -p "$prompt" > "$report" && [[ -s "$report" ]]; then
    rm -f "$context"

    echo
    printf '%s[OK]%s AI report saved:\n' "$GREEN" "$RESET"
    echo "  $report"
    return 0
  fi

  rm -f "$context" "$report"

  echo
  printf '%s[ERROR] AI analysis failed. No report was saved.%s\n' \
    "$RED" "$RESET"

  return 1
}

