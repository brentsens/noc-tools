  echo

  printf '%s%sSYSTEM%s\n' "$SES_ORANGE" "$BOLD" "$RESET"
  printf '%s\n' "──────────────────────────────────────────────────────────────"
  printf '  %s[9]%s   Health Check\n' "$SES_CYAN" "$RESET"
  printf '  %s[10]%s  Regression Tests\n' "$SES_CYAN" "$RESET"
  printf '  %s[11]%s  Exit\n' "$GRAY" "$RESET"
  echo

  read -rp "Selection [1-11]: " choice

    case "$choice" in
        1)
          run_tool noc-start --no-copilot
          pause
          ;;

        2)
          view_shift_notes
          ;;

        3)
          add_shift_note_menu
          ;;

        4)
          tickets_menu
          ;;

        5)
          investigation_menu
          ;;

        6)
          ai_actions_menu
          ;;

        7)
         run_tool noc-status --date "$DAY"
         pause
         ;;

        8)
          run_tool noc-end --date "$DAY"
          pause
         ;;

        9)
         run_tool noc-doctor --deep
         pause
         ;;

        10)
         run_tool noc-test
         pause
         ;;

        11)
         echo
         printf '%sNOC Console closed.%s\n' "$GRAY" "$RESET"
         exit 0
         ;;

        *)
         echo
         printf '%sInvalid selection.%s\n' "$YELLOW" "$RESET"
         sleep 1
         ;;
    esac
done