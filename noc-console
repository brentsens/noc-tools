#!/usr/bin/env bash
# noc-console - interactive front end for the NOC automation toolkit

set -uo pipefail

NO_COLOR=false

# SES-style terminal palette
SES_ORANGE=$'\033[38;5;208m'
SES_CYAN=$'\033[38;5;45m'
GREEN=$'\033[38;5;82m'
YELLOW=$'\033[38;5;220m'
RED=$'\033[38;5;196m'
WHITE=$'\033[97m'
GRAY=$'\033[38;5;245m'
BOLD=$'\033[1m'
DIM=$'\033[2m'
RESET=$'\033[0m'

disable_colors() {
  SES_ORANGE=""
  SES_CYAN=""
  GREEN=""
  YELLOW=""
  RED=""
  WHITE=""
  GRAY=""
  BOLD=""
  DIM=""
  RESET=""
}

DAY=""

usage() {
  cat <<'TXT'
Usage:
  noc-console
  noc-console --yesterday
  noc-console --date YYYY-MM-DD

Options:
  --yesterday        Use the previous calendar day's shift.
  --date YYYY-MM-DD  Use a specific shift date.
  --no-color         Disable terminal colors.
  -h, --help         Show this help.
TXT
}

while [[ $# -gt 0 ]]; do
  case "$1" in
    --yesterday)
      DAY=$(date -d yesterday +%F)
      ;;

    --date)
      [[ $# -ge 2 ]] || {
        echo "ERROR: --date requires YYYY-MM-DD" >&2
        exit 1
      }

      DAY="$2"
      shift
      ;;

    -h|--help)
      usage
      exit 0
      ;;

    --no-color)
      NO_COLOR=true
      disable_colors
      ;;

    *)
      echo "ERROR: Unknown option: $1" >&2
      usage >&2
      exit 1
      ;;
  esac

  shift
done

if [[ -z "$DAY" ]]; then
  DAY=$(date +%F)
fi

date -d "$DAY" >/dev/null 2>&1 || {
  echo "ERROR: Invalid date: $DAY" >&2
  exit 1
}

pause() {
  echo
  read -rp "Press Enter to return to the NOC Console..." _
}

run_tool() {
  local tool="$1"
  local rc

  shift

  if ! command -v "$tool" >/dev/null 2>&1; then
    echo
    echo "[ERROR] $tool not found."
    return 127
  fi

  echo

  "$tool" "$@"
  rc=$?

  echo

  if [[ $rc -eq 0 ]]; then
    echo "[OK] $tool completed."
  else
    echo "[ERROR] $tool failed with exit code $rc."
  fi

  return 0
}

show_header() {
  printf '%s%s' "$SES_ORANGE" "$BOLD"
  echo "╔══════════════════════════════════════════════════════════════╗"
  echo "║                    SES NOC CONSOLE                           ║"
  echo "║                 OPERATIONS CONTROL CENTER                    ║"
  echo "╚══════════════════════════════════════════════════════════════╝"
  printf '%s' "$RESET"
  echo
}

investigation_menu() {
  local inv_choice inv_dir inv_name inv
  local investigation_root="$HOME/noc/$DAY/investigations"

  while true; do
    clear

    printf '%s%s' "$SES_ORANGE" "$BOLD"
    echo "╔══════════════════════════════════════════════════════════════╗"
    echo "║                    NOC INVESTIGATIONS                        ║"
    echo "╚══════════════════════════════════════════════════════════════╝"
    printf '%s' "$RESET"

    echo
    printf 'Shift: %s%s%s\n' "$WHITE" "$DAY" "$RESET"
    echo

    printf '%s%sINVESTIGATION ACTIONS%s\n' "$SES_CYAN" "$BOLD" "$RESET"
    printf '%s\n' "──────────────────────────────────────────────────────────────"
    printf '  %s[1]%s  Create from Final Datadog Notebook\n' "$SES_CYAN" "$RESET"
    printf '  %s[2]%s  Open Existing Investigation\n' "$SES_CYAN" "$RESET"
    printf '  %s[3]%s  List Investigations\n' "$SES_CYAN" "$RESET"
    printf '  %s[4]%s  Back\n' "$GRAY" "$RESET"
    echo

    read -rp "Selection [1-4]: " inv_choice

    case "$inv_choice" in
      1)
        run_tool noc-inv --date "$DAY"
        pause
        ;;

      2)
        echo
        read -rp "Investigation name: " inv_name

        if [[ -z "$inv_name" ]]; then
          echo
          echo "[ERROR] Investigation name is required."
          pause
          continue
        fi

        inv_dir="$investigation_root/$inv_name"

        if [[ ! -f "$inv_dir/investigation.md" ]]; then
          echo
          echo "[ERROR] Investigation not found:"
          echo "  $inv_dir/investigation.md"
          pause
          continue
        fi

        run_tool noc-inv --open "$inv_name"
        pause
        ;;

      3)
        echo

        shopt -s nullglob
        local investigations=("$investigation_root"/*/investigation.md)
        shopt -u nullglob

        if [[ ${#investigations[@]} -eq 0 ]]; then
          echo "No investigations found for $DAY."
        else
          printf '%s%sInvestigations for %s%s\n' \
            "$SES_CYAN" "$BOLD" "$DAY" "$RESET"
          echo

          for inv in "${investigations[@]}"; do
            printf '  %s•%s %s\n' \
              "$SES_ORANGE" "$RESET" "$(basename "$(dirname "$inv")")"
          done
        fi

        pause
        ;;

      4)
        return 0
        ;;

      *)
        echo
        printf '%sInvalid selection.%s\n' "$YELLOW" "$RESET"
        sleep 1
        ;;
    esac
  done
}

show_dashboard() {
  local open_count inv_count handover_state review_state overall_state f

  shopt -s nullglob
  local tickets=("$HOME/noc/tickets/open/"*.json)
  local investigations=("$HOME/noc/$DAY/investigations/"*/investigation.md)
  shopt -u nullglob

  open_count=${#tickets[@]}
  inv_count=${#investigations[@]}

  if [[ -s "$HOME/noc/$DAY/handover/handover-$DAY.md" ]]; then
    handover_state="${GREEN}CREATED${RESET}"
  else
    handover_state="${YELLOW}PENDING${RESET}"
  fi

  review_state="${GREEN}NO${RESET}"
  overall_state="${GREEN}● READY${RESET}"

  for f in "${tickets[@]}"; do
    if [[ "$(jq -r '.jira.status // ""' "$f" 2>/dev/null)" =~ ^(Done|Closed|Resolved)$ ]]; then
      review_state="${YELLOW}YES${RESET}"
      overall_state="${YELLOW}● REVIEW REQUIRED${RESET}"
      break
    fi
  done

  printf '%s%sSHIFT OVERVIEW%s\n' "$SES_CYAN" "$BOLD" "$RESET"
  printf '%s\n' "──────────────────────────────────────────────────────────────"
  printf '  Shift:          %s\n' "$DAY"
  printf '  Status:         %b\n' "$overall_state"
  echo

  printf '%s%sOPERATIONS%s\n' "$SES_CYAN" "$BOLD" "$RESET"
  printf '%s\n' "──────────────────────────────────────────────────────────────"
  printf '  Open Jira:      %s%d%s\n' "$WHITE" "$open_count" "$RESET"
  printf '  Investigations: %s%d%s\n' "$WHITE" "$inv_count" "$RESET"
  printf '  Needs Review:   %b\n' "$review_state"
  printf '  Handover:       %b\n' "$handover_state"
  echo
}

while true; do
  clear

  show_header
  show_dashboard

  printf '%s%sSHIFT OPERATIONS%s\n' "$SES_ORANGE" "$BOLD" "$RESET"
  printf '%s\n' "──────────────────────────────────────────────────────────────"
  printf '  %s[1]%s  Start Shift\n' "$SES_CYAN" "$RESET"
  printf '  %s[2]%s  View Status\n' "$SES_CYAN" "$RESET"
  printf '  %s[3]%s  Sync Jira\n' "$SES_CYAN" "$RESET"
  printf '  %s[4]%s  Investigations\n' "$SES_CYAN" "$RESET"
  echo

  printf '%s%sSHIFT CONTROL%s\n' "$SES_ORANGE" "$BOLD" "$RESET"
  printf '%s\n' "──────────────────────────────────────────────────────────────"
  printf '  %s[5]%s  End Shift\n' "$SES_CYAN" "$RESET"
  printf '  %s[6]%s  Health Check\n' "$SES_CYAN" "$RESET"
  echo

  printf '%s%sSYSTEM%s\n' "$SES_ORANGE" "$BOLD" "$RESET"
  printf '%s\n' "──────────────────────────────────────────────────────────────"
  printf '  %s[7]%s  Regression Tests\n' "$SES_CYAN" "$RESET"
  printf '  %s[8]%s  Exit\n' "$GRAY" "$RESET"
  echo

  read -rp "Selection [1-8]: " choice

    case "$choice" in
      1)
        run_tool noc-start
        ;;

      2)
        run_tool noc-status --date "$DAY"
        pause
        ;;

      3)
        run_tool tix sync --all
        pause
        ;;

      4)
        investigation_menu
        ;;

      5)
        run_tool noc-end --date "$DAY"
        pause
        ;;

      6)
        run_tool noc-doctor --deep
        pause
        ;;

      7)
        run_tool noc-test
        pause
        ;;

      8)
        echo
        printf '%sNOC Console closed.%s\n' "$GRAY" "$RESET"
        exit 0
        ;;

      *)
        echo
        printf '%sInvalid selection.%s\n' "$YELLOW" "$RESET"
        sleep 1
        ;;
  esac
done