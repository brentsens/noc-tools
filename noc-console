show_dashboard() {
  local open_count inv_count handover_state review_state overall_state f

  shopt -s nullglob
  local tickets=("$HOME/noc/tickets/open/"*.json)
  local investigations=("$HOME/noc/$DAY/investigations/"*/investigation.md)
  shopt -u nullglob

  open_count=${#tickets[@]}
  inv_count=${#investigations[@]}

  if [[ -s "$HOME/noc/$DAY/handover/handover-$DAY.md" ]]; then
    handover_state="${GREEN}CREATED${RESET}"
  else
    handover_state="${YELLOW}PENDING${RESET}"
  fi

  review_state="${GREEN}NO${RESET}"
  overall_state="${GREEN}● READY${RESET}"

  for f in "${tickets[@]}"; do
    if [[ "$(jq -r '.jira.status // ""' "$f" 2>/dev/null)" =~ ^(Done|Closed|Resolved)$ ]]; then
      review_state="${YELLOW}YES${RESET}"
      overall_state="${YELLOW}● REVIEW REQUIRED${RESET}"
      break
    fi
  done

  printf '%s%sSHIFT OVERVIEW%s\n' "$SES_CYAN" "$BOLD" "$RESET"
  printf '%s\n' "──────────────────────────────────────────────────────────────"
  printf '  Shift:          %s\n' "$DAY"
  printf '  Status:         %b\n' "$overall_state"
  echo

  printf '%s%sOPERATIONS%s\n' "$SES_CYAN" "$BOLD" "$RESET"
  printf '%s\n' "──────────────────────────────────────────────────────────────"
  printf '  Open Jira:      %s%d%s\n' "$WHITE" "$open_count" "$RESET"
  printf '  Investigations: %s%d%s\n' "$WHITE" "$inv_count" "$RESET"
  printf '  Needs Review:   %b\n' "$review_state"
  printf '  Handover:       %b\n' "$handover_state"
  echo
}

