  echo "║                    SES NOC CONSOLE                           ║"
  echo "║                 OPERATIONS CONTROL CENTER                    ║"
  echo "╚══════════════════════════════════════════════════════════════╝"
  printf '%s' "$RESET"
  echo
}

append_shift_note() {
  local section="$1"
  local note="$2"
  local notes="$HOME/noc/$DAY/shift-notes.md"
  local tmp timestamp

  if [[ ! -s "$notes" ]]; then
    echo
    printf '%s[ERROR] Shift notes not created yet.%s\n' "$RED" "$RESET"
    echo "Run Start Shift first."
    return 1
  fi

  timestamp=$(date '+%H:%M')
  tmp=$(mktemp)

  awk \
    -v heading="## $section" \
    -v entry="- $timestamp $note" '
    BEGIN {
      inserted=0
      found=0
    }

    $0 == heading {
      found=1
      print
      next
    }

    found && !inserted && /^## / {
      print entry
      print ""
      inserted=1
    }

    {
      print
    }

    END {
      if (found && !inserted) {
        print entry
      }
    }
  ' "$notes" > "$tmp"

  if ! grep -Fq -- "$section" "$notes"; then
    rm -f "$tmp"
    echo
    printf '%s[ERROR] Section not found: %s%s\n' "$RED" "$section" "$RESET"
    return 1
  fi

  mv "$tmp" "$notes"

  echo
  printf '%s[OK]%s Added to %s\n' "$GREEN" "$RESET" "$section"
}

