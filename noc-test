    fail "malformed generated record was not preserved"
  fi

  if ! grep -Fq "Reviewed investigation: $INV_NAME" "$INV_NOTES"; then
    pass "malformed investigation was withheld from shift notes"
  else
    fail "malformed investigation leaked into shift notes"
  fi

  if grep -Fq "failed output validation" "$LAB/inv-malformed.out"; then
    pass "malformed investigation displayed output-validation warning"
  else
    fail "output-validation warning missing"
  fi

  rm -f "$MOCK_STATE/copilot-output"
fi

printf '\n18. noc-inv Invalid URL Rejection\n'
if [[ -z "${PROD[noc-inv]}" ]]; then
  skip "noc-inv not installed"
else
  if printf 'synthetic-investigation\nhttps://example.invalid/not-a-notebook\n' | noc-inv >"$LAB/inv-invalid.out" 2>&1; then
    fail "invalid Notebook URL unexpectedly accepted"
  else
    pass "invalid Notebook URL rejected"
  fi
  if find "$HOME/noc" -path '*/investigations/synthetic-investigation/investigation.md' -print -quit | grep -q .; then fail "invalid URL created investigation record"; else pass "invalid URL created no investigation record"; fi
fi

printf '\n19. noc-end Existing Handover / Skip Sync\n'

if [[ -z "${PROD[noc-end]:-}" ]]; then
  skip "noc-end not available"
else
  END_DAY="2026-10-21"
  END_SHIFT="$HOME/noc/$END_DAY"
  END_HANDOVER="$END_SHIFT/handover/handover-$END_DAY.md"
  END_TEST_BIN="$LAB/end-test-bin"
  TIX_SENTINEL="$LAB/tix-called"

  mkdir -p "$END_SHIFT/handover"
  mkdir -p "$END_TEST_BIN"

  printf '# Synthetic shift notes\n' > "$END_SHIFT/shift-notes.md"
  printf 'ORIGINAL HANDOVER\n' > "$END_HANDOVER"

  handover_before=$(sha256sum "$END_HANDOVER" | awk '{print $1}')

  # tix must NOT run when --skip-sync is used.
  cat > "$END_TEST_BIN/tix" <<EOF
#!/usr/bin/env bash
touch "$TIX_SENTINEL"
echo "ERROR: tix should not have been called" >&2
exit 99
EOF
  chmod +x "$END_TEST_BIN/tix"

  # Synthetic clear noc-status.
  cat > "$END_TEST_BIN/noc-status" <<'MOCK'
#!/usr/bin/env bash
cat <<'OUT'
NOC STATUS

Shift
  [OK] Shift directory
  [OK] Shift notes available

Needs Review
  Review: None detected

Investigations
  Investigations: None

Read-only status check complete. No records were changed.
OUT
exit 0
MOCK
  chmod +x "$END_TEST_BIN/noc-status"

  # Synthetic healthy noc-doctor.
  cat > "$END_TEST_BIN/noc-doctor" <<'MOCK'
#!/usr/bin/env bash
cat <<'OUT'
NOC DOCTOR

Result
  Passed:   10
  Warnings: 2
  Failed:   0
  Health:   HEALTHY WITH WARNINGS
OUT
exit 0
MOCK
  chmod +x "$END_TEST_BIN/noc-doctor"

  # Must not run because the synthetic handover already exists.
  cat > "$END_TEST_BIN/noc-handover" <<'MOCK'
#!/usr/bin/env bash
echo "ERROR: noc-handover should not have been called" >&2
exit 99
MOCK
  chmod +x "$END_TEST_BIN/noc-handover"

  if printf '3\n' |
   PATH="$END_TEST_BIN:$MOCK_BIN:/usr/bin:/bin" \
   noc-end --date "$END_DAY" --skip-sync \
   >"$LAB/noc-end-existing.out" 2>&1; then
    pass "noc-end existing-handover path completed"
  else
    fail "noc-end existing-handover path failed"
  fi

  handover_after=$(sha256sum "$END_HANDOVER" | awk '{print $1}')

  assert_eq \
    "$handover_after" \
    "$handover_before" \
    "noc-end preserved existing handover"

  if [[ ! -e "$TIX_SENTINEL" ]]; then
    pass "noc-end --skip-sync did not call tix"
  else
    fail "noc-end --skip-sync unexpectedly called tix"
  fi

  if grep -Fq "Jira freshness:    SKIPPED" \
      "$LAB/noc-end-existing.out"; then
    pass "noc-end honored --skip-sync"
  else
    fail "noc-end did not report skipped Jira sync"
  fi

  if grep -Fq "Shift status:      CLEAR" \
      "$LAB/noc-end-existing.out"; then
    pass "noc-end reported clear shift status"
  else
    fail "noc-end clear shift status missing"
  fi

  if grep -Fq "Automation health: HEALTHY WITH WARNINGS" \
      "$LAB/noc-end-existing.out"; then
    pass "noc-end preserved healthy-with-warnings state"
  else
    fail "noc-end health summary incorrect"
  fi

  if grep -Fq "Handover:          ALREADY EXISTS" \
      "$LAB/noc-end-existing.out"; then
    pass "noc-end detected existing handover"
  else
    fail "noc-end failed to detect existing handover"
  fi

  if grep -Fq "READY FOR HANDOVER" \
      "$LAB/noc-end-existing.out"; then
    pass "noc-end reached handover readiness"
  else
    fail "noc-end did not reach handover readiness"
  fi

  if grep -Fq "Existing handover was not overwritten." \
      "$LAB/noc-end-existing.out"; then
    pass "noc-end reported overwrite protection"
  else
    fail "noc-end overwrite protection message missing"
  fi

  if grep -Fq "Handover delivery skipped." \
      "$LAB/noc-end-existing.out"; then
    pass "noc-end allowed delivery to be skipped"
  else
    fail "noc-end delivery-skip confirmation missing"
  fi
fi

printf '\nResult\n'
printf '  Passed:  %d\n' "$PASS"
printf '  Failed:  %d\n' "$FAIL"
printf '  Skipped: %d\n' "$SKIP"
if [ "$FAIL" -gt 0 ]; then
  printf '  Status:  FAILED\n\n'
  echo "Inspect retained output with: noc-test --keep"
  exit 1
else
  printf '  Status:  PASSED\n\n'
  exit 0
fi
