{"key":"NOC-9002","summary":"Changed Jira title","description":"Changed Jira description","status":"Done","assignee":"Changed Owner","priority":"Highest"}
JSON
  before=$(sha256sum "$rec2" | awk '{print $1}')
  if printf 'n\n' | tix sync NOC-9002 >"$LAB/sync-decline.out" 2>&1; then pass "sync decline completed safely"; else fail "sync decline command failed"; fi
  after=$(sha256sum "$rec2" | awk '{print $1}')
  assert_eq "$after" "$before" "declined sync preserved entire record"

  printf '\n6. tix Sync Accept / NOC Preservation\n'
  old_env=$(jq -r '.noc.environment' "$rec2")
  old_next=$(jq -r '.noc.next_action' "$rec2")
  old_notes=$(jq -r '.noc.notes' "$rec2")
  if printf 'y\n' | tix sync NOC-9002 >"$LAB/sync-accept.out" 2>&1; then
    pass "approved sync completed"
    assert_eq "$(jq -r '.jira.status' "$rec2")" "Done" "sync updated Jira status"
    assert_eq "$(jq -r '.jira.assignee' "$rec2")" "Changed Owner" "sync updated Jira assignee"
    assert_eq "$(jq -r '.noc.environment' "$rec2")" "$old_env" "sync preserved NOC environment"
    assert_eq "$(jq -r '.noc.next_action' "$rec2")" "$old_next" "sync preserved NOC next action"
    assert_eq "$(jq -r '.noc.notes' "$rec2")" "$old_notes" "sync preserved NOC notes"
  else
    fail "approved sync failed"
  fi

  printf '\n7. tix Atlas Failure Preservation\n'
  before=$(sha256sum "$rec2" | awk '{print $1}')
  printf 'servicefail\n' > "$MOCK_STATE/atlas-mode"

  if tix sync NOC-9002 >"$LAB/sync-fail.out" 2>&1; then 
    fail "failed Atlas sync unexpectedly returned success"; 
  else 
    pass "Atlas failure reported"; 
  fi
  after=$(sha256sum "$rec2" | awk '{print $1}')

  assert_eq "$after" "$before" \
  "Atlas failure preserved existing record"

  printf 'success\n' > "$MOCK_STATE/atlas-mode"


