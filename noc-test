#!/usr/bin/env bash
# noc-test - isolated regression tests for the NOC automation stack
# Usage: noc-test [--keep]
set -uo pipefail

KEEP=false
while [ $# -gt 0 ]; do
  case "$1" in
    --keep) KEEP=true ;;
    -h|--help) sed -n '2,3p' "$0"; exit 0 ;;
    *) echo "ERROR: Unknown option: $1" >&2; exit 2 ;;
  esac
  shift
done

PASS=0; FAIL=0; SKIP=0
pass(){ PASS=$((PASS+1)); printf '  [PASS] %s\n' "$1"; }
fail(){ FAIL=$((FAIL+1)); printf '  [FAIL] %s\n' "$1"; }
skip(){ SKIP=$((SKIP+1)); printf '  [SKIP] %s\n' "$1"; }
assert_eq(){ local got="$1" want="$2" name="$3"; [[ "$got" == "$want" ]] && pass "$name" || { fail "$name (got: $got; expected: $want)"; return 1; }; }

for req in bash jq sha256sum mktemp; do
  command -v "$req" >/dev/null 2>&1 || { echo "ERROR: $req is required" >&2; exit 2; }
done

# Capture production command paths before replacing HOME/PATH.
SCRIPT_DIR=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)
declare -A PROD

for cmd in tix noc-start noc-status noc-inv noc-handover noc-end; do
  if [[ -x "$SCRIPT_DIR/$cmd" ]]; then
    PROD[$cmd]="$SCRIPT_DIR/$cmd"
  else
    PROD[$cmd]=$(command -v "$cmd" 2>/dev/null || true)
  fi
done

LAB=$(mktemp -d "${TMPDIR:-/tmp}/noc-test.XXXXXX")
TEST_HOME="$LAB/home"
MOCK_BIN="$LAB/bin"
mkdir -p "$TEST_HOME/noc/tickets/open" "$TEST_HOME/noc/tickets/closed" "$MOCK_BIN"
cleanup(){ if $KEEP; then echo "Test lab retained: $LAB"; else rm -rf "$LAB"; fi; }
trap cleanup EXIT INT TERM

# Link installed scripts into the isolated PATH. No test writes to production HOME.
for cmd in tix noc-start noc-status noc-inv noc-handover noc-end; do
  if [[ -n "${PROD[$cmd]}" ]]; then ln -s "${PROD[$cmd]}" "$MOCK_BIN/$cmd"; fi
done

# Safe mocks. Atlas mode and response are controlled by files inside the lab.
cat > "$MOCK_BIN/atlas" <<'MOCK'
#!/usr/bin/env bash

if [[ "${1:-}" == "--help" ]]; then
  echo "mock atlas"
  exit 0
fi

requested_id="${@: -1}"

ticket_mode_file="${MOCK_STATE:?}/atlas-mode-${requested_id}"
default_mode_file="${MOCK_STATE:?}/atlas-mode"

if [[ -f "$ticket_mode_file" ]]; then
  mode=$(cat "$ticket_mode_file")
else
  mode=$(cat "$default_mode_file" 2>/dev/null || echo success)
fi

case "$mode" in
  authfail)    exit 4 ;;
  servicefail) exit 5 ;;
  notfound)    exit 6 ;;
esac

ticket_response="${MOCK_STATE:?}/atlas-${requested_id}.json"
default_response="${MOCK_STATE:?}/atlas-response.json"

if [[ -f "$ticket_response" ]]; then
  cat "$ticket_response"
elif [[ -f "$default_response" ]]; then
  cat "$default_response"
else
  exit 6
fi
MOCK

chmod +x "$MOCK_BIN/atlas"

cat > "$MOCK_BIN/copilot" <<'MOCK'
#!/usr/bin/env bash
if [[ -f "${MOCK_STATE:?}/copilot-fail" ]]; then exit 1; fi
if [[ -f "${MOCK_STATE:?}/copilot-output" ]]; then cat "${MOCK_STATE:?}/copilot-output"; else echo '# Mock Copilot Output'; fi
MOCK
chmod +x "$MOCK_BIN/copilot"

export HOME="$TEST_HOME"
export MOCK_STATE="$LAB/state"
export PATH="$MOCK_BIN:/usr/bin:/bin"
mkdir -p "$MOCK_STATE"

create_test_ticket() {
  local root="$1"
  local id="$2"
  local summary="$3"
  local status="$4"
  local assignee="$5"
  local environment="$6"
  local next_action="$7"
  local notes="$8"

  mkdir -p "$root/open" "$root/closed"

  jq -n \
    --arg id "$id" \
    --arg summary "$summary" \
    --arg status "$status" \
    --arg assignee "$assignee" \
    --arg environment "$environment" \
    --arg next_action "$next_action" \
    --arg notes "$notes" \
    '{
      id: $id,
      jira: {
        summary: $summary,
        description: "Synthetic description",
        status: $status,
        assignee: $assignee,
        priority: "Medium"
      },
      noc: {
        environment: $environment,
        next_action: $next_action,
        notes: $notes
      },
      metadata: {
        source: "atlas",
        created: "2026-10-20T16:00:00-05:00",
        last_synced: "2026-10-20T16:00:00-05:00"
      }
    }' > "$root/open/$id.json"
}

printf 'success\n' > "$MOCK_STATE/atlas-mode"

printf '\nNOC TEST - ISOLATED LAB\n'
