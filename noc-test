  cat > "$MOCK_STATE/atlas-response.json" <<'JSON'
{"key":"NOC-9002","summary":"Synthetic Atlas issue","description":"Synthetic Jira description","status":"Escalated","assignee":"Test Engineer","priority":"Medium"}
JSON
