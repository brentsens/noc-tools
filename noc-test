  if bash -n "${PROD[$cmd]}" >/dev/null 2>&1; then pass "$cmd syntax valid"; else fail "$cmd syntax invalid"; fi
done

if [[ -z "${PROD[tix]}" ]]; then
  skip "tix regression tests skipped; tix not installed"
else
  printf '\n2. tix Manual Fallback\n'
  printf 'authfail\n' > "$MOCK_STATE/atlas-mode"
  manual_input=$'1\nManual issue\nManual description\nOpen\nNOC\nMedium\nTEST\nInvestigate manually\nSynthetic notes\ny\n'
  if printf '%s' "$manual_input" | tix add NOC-9001 >"$LAB/manual.out" 2>&1; then
    rec="$HOME/noc/tickets/open/NOC-9001.json"
    [[ -f "$rec" ]] && pass "manual fallback created JSON record" || fail "manual fallback record missing"
    assert_eq "$(jq -r '.metadata.source' "$rec")" "manual" "manual source recorded"
    assert_eq "$(jq -r '.jira.description' "$rec")" "Manual description" "manual Jira description recorded"
    assert_eq "$(jq -r '.noc.next_action' "$rec")" "Investigate manually" "manual NOC next action recorded"
  else
    fail "manual fallback command failed"
  fi

