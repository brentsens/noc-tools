    rec2="$HOME/noc/tickets/open/NOC-9002.json"
    assert_eq "$(jq -r '.metadata.source' "$rec2")" "atlas" "Atlas source recorded"
    assert_eq "$(jq -r '.jira.status' "$rec2")" "Escalated" "Atlas status parsed"
    assert_eq "$(jq -r '.jira.assignee' "$rec2")" "Test Engineer" "Atlas assignee parsed"
    assert_eq "$(jq -r '.noc.environment' "$rec2")" "LAB" "NOC environment recorded"
